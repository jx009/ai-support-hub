# Install inside an existing HTTPS server {} block configured by your panel.
# Proxy all paths; /hooks must be reachable by Chatwoot.
location / {
    proxy_pass http://127.0.0.1:4080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
    client_max_body_size 1m;
}
# Do not add X-Frame-Options: DENY globally:
# /widget uses a per-project CSP frame-ancestors allowlist.
