# Generate real keys with: node scripts/init-env.mjs
PUBLIC_URL=https://support.example.com
SUPPORT_PORT=6001
# Keep loopback for HTTPS reverse proxy; use 0.0.0.0 for direct IP testing.
SUPPORT_BIND_ADDRESS=127.0.0.1
# Set to your published Docker Hub image when deploying prebuilt images.
SUPPORT_IMAGE=ai-support-hub
SUPPORT_IMAGE_TAG=local
POSTGRES_PASSWORD=replace_with_generated_value
MASTER_KEY=replace_with_64_hex_characters
ADMIN_TOKEN=replace_with_a_long_random_token
TRUST_PROXY_HOPS=1
ALLOW_HTTP_UPSTREAMS=false
# MaxKB request deadline in milliseconds (1000–600000); default: 10 minutes.
AI_TIMEOUT_MS=600000
WORKER_CONCURRENCY=2

# Only used by deploy/providers.compose.yml
CHATWOOT_IMAGE=chatwoot/chatwoot:v4.18.0
CHATWOOT_PUBLIC_URL=https://chatwoot.example.com
CHATWOOT_FORCE_SSL=true
CHATWOOT_SECRET_KEY_BASE=replace_with_generated_value
CHATWOOT_DB_PASSWORD=replace_with_generated_value
CHATWOOT_REDIS_PASSWORD=replace_with_generated_value
MAXKB_IMAGE=1panel/maxkb:v2.10.6-lts

# Optional staff invitations / email delivery through Chatwoot
MAILER_SENDER_EMAIL=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
# For port 465, set SMTP_TLS=true and SMTP_ENABLE_STARTTLS_AUTO=false.
SMTP_TLS=false
